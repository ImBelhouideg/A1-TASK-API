# Copy this file to .env and fill in your real values. .env is gitignored.

# --- OpenRouter (Stage 0) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key_here
LLM_MODEL=openrouter/free

# --- Stage 1: stub mode. Set to 1 to skip the model entirely (free, instant) ---
LLM_STUB=0

# --- Stage 4: kill switch. Set to false to disable the model and return a fallback ---
LLM_ENABLED=true